# Windows Explorer folder-view metadata
desktop.ini

# Scratch space for the Game1.xlsx audit tooling — its own node_modules, the
# per-sheet preview PNGs, and the ndjson logs it writes. Regenerated on demand
# and no part of the game itself, which has no build step or dependencies.
.codex-tmp/

# Session state for the pi coding agent — transcripts and scratch files, local
# to this machine and no part of the game.
.pi/

# Generated workbook exports, one directory per run.
outputs/
.claude/settings.local.json

# Raw pixel dump for tools/sprite-harness.js, regenerated by tools/dump-sheet.py.
tools/sheet.raw
tools/sheet.json
